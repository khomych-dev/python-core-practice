# ==========================================
# GARAGE MANAGEMENT API - ENVIRONMENT CONFIG
# ==========================================

# 1. Database Configuration
POSTGRES_USER=garage_admin
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=garage_db
DATABASE_URL=postgresql+asyncpg://garage_admin:your_secure_db_password_here@db:5432/garage_db
DATABASE_URL_TEST=postgresql+asyncpg://garage_admin:your_secure_db_password_here@localhost:5432/garage_test_db

# 2. Redis Configuration (Caching & Background Tasks)
REDIS_URL=redis://redis:6379/0

# 3. Security
# Згенеруй новий ключ командою: openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. OpenAI Integration (AI Summary)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# 5. Langfuse (AI Tracing & Analytics)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# 6. Stripe Integration (Billing & Webhooks)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
